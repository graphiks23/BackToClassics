{
    "$schema": "https://ext.nulls.gg/mods/schema/schema.json",
    "@title": {
        "EN":               "Back To Classics",
        "RU":               "Back To Classics"
    },
    "@description": {
        "EN":               "Back To Classics is a total conversion mod that brings back many of the old aspects of Brawl Stars, such as old UI elements, environments, models, and more.",
        "RU":               "Back To Classics — это полная модификация, возвращающая многие старые элементы Brawl Stars: интерфейс, окружение, модели и многое другое."
    },
    "@author":              "<a href=\"https://t.me/backtoclassics\">@BackToClassics</a>",
    "@version":             "3.2.80",
    "@ilib": true,
    "@categories": [
                            "gui",
                            "sfx",
                            "texts",
                            "skins",
                            "music",
                            "environment",
                            "localization"
    ],
    "@gv": 68,
    "@feature_groups": {
        "pins": {
            "@name": {
                "EN":       "Pin settings",
                "RU":       "Настройки значков"
            },
            "@description": {
                "EN":       "Changes behaviour of pins.\nSelect none for default behaviour.",
                "RU":       "Изменяет поведение значков.\nВыбери «ничего», чтобы использовать поведение по умолчанию."
            },
            "@type":        "RADIO_GROUP",
            "@features": [
                            "staticEmoji",
                            "coolerEmoji"
            ]
        },

         "profilePicker": {
            "@name": {
                "EN":       "Profile UI",
                "RU":       "Интерфейс профиля"
            },
            "@description": {
                "EN":       "Choose your preferred profile UI. Choose none to use vanilla UI.",
                "RU":       "Выбери предпочитаемый интерфейс профиля. Выбери «ничего», чтобы использовать стандартный интерфейс."
            },
            "@type":        "RADIO_GROUP",
            "@features": [
                            "oldenProfile",
                            "socialsUpdProfile",
                            "revampProfile"
            ]
            
        },
        "misc": {
            "@name": {
                "EN":       "Misc. settings",
                "RU":       "Прочие настройки"
            },
            "@type":        "DEFAULT",
            "@features": [
                            "noSpecialEvents",
                            "mutePins",
                            "gatchaPatch",
                            "noSkinRarity"
            ]
        },
        
         "oldFeatures": {
            "@name": {
                "EN":       "Old Features",
                "RU":       "Старые функции"
            },
            "@type":        "DEFAULT",
            "@features": [
                            "oldModels",
                            "oldshop",
                            "oldEnvs",
                            "oldPortraits",
                            "classicBrawlerSort"
            ]
        },

        "rankSelect": {
            "@name": {
                "EN":       "Rank system",
                "RU":       "Система рангов"
            },
            "@type":        "RADIO_GROUP",
            "@features": [
                            "classicRanks",
                            "jujuRanks"
            ]
        },

        "dailyWins": {
            "@name": {
                "EN":       "Daily Wins",
                "RU":       "Победы дня"
            },
            "@description": {
                "EN":       "Select none to use default version of Daily Wins.\n(Daily Wins are disabled in Null's Brawl)",
                "RU":       "Выбери «ничего», чтобы использовать стандартную версию ежедневных побед.\n(Ежедневные победы отключены в Null's Brawl)"
            },
            "@type":        "RADIO_GROUP",
            "@features": [
                            "dailyWinsClassic",
                            "dailyWinsTokenBar"
            ]
        },

        "swfPatch": {
            "@name": {
                "EN":       "SupercellSWF Patches",
                "RU":       "Патчи SupercellSWF"
            },
            "@description": {
                "EN":       "Enable/Disable certain aspects of the mod",
                "RU":       "Включает или отключает отдельные части мода"
            },
            "@type":        "DEFAULT",
            "@features": [
                            "uiPatch",
                            "brawlPassPatch",
                            "buddyPatch",
                            "themePatch",
                            "eventsPatch",
                            "twCommonPatch",
                            "shopPatch",
                            "questPatch"
            ]
        },

        "ziggyStars": {
            "@name": {
                "EN":       "??????",
                "RU":       "??????"
            },
            "@description": {
                "EN":       "¿¿¿¿¿¿",
                "RU":       "¿¿¿¿¿¿"
            },
            "@type":        "DEFAULT",
            "@features": [
                            "nothingOutOfTheOrdinary"
            ]
        }
        
    },
    "@features": {
        "oldshop": {
            "@name": {
                "EN":       "Old shop",
                "RU":       "Старый магазин"
            },
            "@description": {
                "EN":       "Enables the old shop (broken offers)",
                "RU":       "Включает старую версию магазина (сломанные предложения)"
            },
            "@enabled": false,
            "@priority": 1,
            "@patches":     "shop/oldshop.json"
        },
        "staticEmoji": {
            "@name": {
                "EN":       "Static Pins",
                "RU":       "Статичные значки"
            },
            "@description": {
                "EN":       "Removes all animation from pins",
                "RU":       "Убирает всю анимацию значков"
            },
            "@enabled": true,
            "@priority": 0,
            "@root":        "swfPatch/emojiPatches/staticEmoji",
            "@patches":     "swfPatch/emojiPatches/staticEmoji/emojiPatchStatic.json"
        },
        "coolerEmoji": {
            "@name": {
                "EN":       "Pop-in Pins",
                "RU":       "Всплывающие значки"
            },
            "@description": {
                "EN":       "Adds a small scale-in animation to pins (will break pins in shop and brawl pass)",
                "RU":       "Добавляет значкам небольшую анимацию увеличения при появлении (сломает значки в магазине и Brawl Pass)"
            },
            "@enabled": false,
            "@priority": 0,
            "@root":        "swfPatch/emojiPatches/coolerEmoji",
            "@patches":     "swfPatch/emojiPatches/coolerEmoji/emojiPatchCooler.json"
        },
        "mutePins": {
            "@name": {
                "EN":       "Disable pin sounds",
                "RU":       "Отключить звук значков"
            },
            "@description": {
                "EN":       "Removes all sounds played by pins",
                "RU":       "Убирает все звуки, которые проигрываются значками"
            },
            "@enabled": true,
            "@priority": 1,
            "@patches":     "swfPatch/emojiPatches/mutePins.json"
        },
        "oldPortraits": {
            "@name": {
                "EN":       "Old brawler portraits",
                "RU":       "Старые портреты бойцов"
            },
            "@description": {
                "EN":       "Use old brawler portraits",
                "RU":       "Использовать старые портреты бойцов"
            },
            "@enabled": true,
            "@priority": 1,
            "@patches":     "skins/oldPortraits/oldPlayerThumbnails.json",
            "@root":        "skins/oldPortraits"
        },
        "uiPatch": {
            "@name": {
                "EN":       "Enable UI Patches",
                "RU":       "Включить патчи интерфейса"
            },
            "@description": {
                "EN":       "Things like homescreen, battle end screen, combat hud, etc.",
                "RU":       "Домашний экран, экран завершения боя, боевой интерфейс и т. д."
            },
            "@enabled": true,
            "@priority": 1,
            "@patches": [
                            "swfPatch/ui/rankupVO.json",
                            "logic/btcButton.json"
            ],
            "@root":        "swfPatch/ui"
        },
        "brawlPassPatch": {
            "@name": {
                "EN":       "Enable Brawl Pass Patch",
                "RU":       "Включить патч Brawl Pass"
            },
            "@enabled": true,
            "@priority": 1,
            "@root":        "swfPatch/brawlPass"
        },
        "buddyPatch": {
            "@name": {
                "EN":       "Enable Buddy Patches",
                "RU":       "Включить патчи баффи"
            },
            "@enabled": true,
            "@priority": 1,
            "@root":        "swfPatch/buddy"
        },
        "themePatch": {
            "@name": {
                "EN":       "Enable classic theme",
                "RU":       "Включить классическую тему"
            },
            "@description": {
                "EN":       "Enable or disable the custom loading screen and lobby background",
                "RU":       "Включает или отключает пользовательский экран загрузки и фон лобби"
            },
            "@enabled": true,
            "@priority": 1,
            "@root":        "swfPatch/classicTheme",
            "@patches":     "swfPatch/classicTheme/btcTheme.json"
        },
        "eventsPatch": {
            "@name": {
                "EN":       "Enable static event banners",
                "RU":       "Включить статичные баннеры событий"
            },
            "@enabled": true,
            "@priority": 1,
            "@patches":     "logic/eventBanners.json"
        },
        "twCommonPatch": {
            "@name": {
                "EN":       "twCommon patch",
                "RU":       "Патч twCommon"
            },
            "@enabled": true,
            "@priority": 1,
            "@root":        "swfPatch/twCommon"
        },
        "shopPatch": {
            "@name": {
                "EN":       "Enable New Shop Patches",
                "RU":       "Включить патчи нового магазина"
            },
            "@description": {
                "EN":       "Enable patches for the new version of shop (like removing tabs)",
                "RU":       "Включает патчи для новой версии магазина, например удаление вкладок"
            },
            "@enabled": false,
            "@priority": 1,
            "@patches":     [
                            "swfPatch/shop/shopTabs.json",
                            "client/pleaseDoNotActuallyUseThisShittyWorkaround.json"
                            ],

            "@root":        "swfPatch/shop"
        },
        "questPatch": {
            "@name": {
                "EN":       "Enable Quest Patches",
                "RU":       "Включить патчи заданий"
            },
            "@description": {
                "EN":       "Enable patches for quest tab (including replacing XP rewards to tokens)",
                "RU":       "Включает патчи для вкладки заданий (включая замену наград в виде опыта на жетоны)"
            },
            "@enabled": true,
            "@priority": 1,
            "@root":        "swfPatch/quests"
        },
        "noSpecialEvents": {
            "@name": {
                "EN":       "Remove ongoing special event",
                "RU":       "Убрать текущее особое событие"
            },
            "@description": {
                "EN":       "Remove event button from mainscreen and effects",
                "RU":       "Убирает кнопку события с главного экрана и эффекты"
            },
            "@enabled": true,
            "@priority": 1,
            "@patches":     "logic/disableSpecialEvents.json"
        },
        "nothingOutOfTheOrdinary": {
            "@name": {
                "EN":       "??????",
                "RU":       "??????"
            },
            "@description": {
                "EN":       "¿¿¿¿¿¿",
                "RU":       "¿¿¿¿¿¿"
            },
            "@enabled": false,
            "@priority": 999,
            "@conflicts": [
                            "uiPatch"
            ],
            "@root":        "swfPatch/superSecretSettings/doNotEnter/seriouslyDont/nothingHere/",
            "@patches":     "swfPatch/superSecretSettings/doNotEnter/seriouslyDont/nothingHere/fuckTheGameUp.json"
        },
        "dailyWinsClassic": {
            "@name": {
                "EN":       "Classic Daily Wins bar",
                "RU":       "Классическая шкала ежедневных побед"
            },
            "@description": {
                "EN":       "Use the classic black Daily Wins bar",
                "RU":       "Использовать классическую чёрную шкалу ежедневных побед"
            },
            "@enabled": true,
            "@priority": 1,
            "@root":        "swfPatch/dailyWins"
        },
        "dailyWinsTokenBar": {
            "@name": {
                "EN":       "Token counter",
                "RU":       "Счётчик жетонов"
            },
            "@description": {
                "EN":       "Replace daily wins with the classic token counter",
                "RU":       "Заменяет ежедневные победы классическим счётчиком жетонов"
            },
            "@enabled": false,
            "@priority": 1,
            "@patches":     "swfPatch/dailyWins/tokenBar.json",
            "@root":        "swfPatch/dailyWins"
        },
        "oldEnvs": {
            "@name": {
                "EN":       "Old environments",
                "RU":       "Старые окружения"
            },
            "@description": {
                "EN":       "Replace all environments with old ones",
                "RU":       "Заменяет все окружения старыми"
            },
            "@enabled": true,
            "@priority": 1,
            "@patches": [
                            "envs/config/retropolis.json",
                            "envs/locations/retropolis.json",
                            "envs/config/darrylsShip.json",
                            "envs/locations/darrylsShip.json",
                            "envs/config/taraBazaar.json",
                            "envs/locations/taraBazaar.json",
                            "envs/locations/oldTraining.json",
                            "envs/config/oldTraining.json",
                            "envs/config/snowyRemix.json",
                            "envs/locations/snowyRemixTODO.json"
            ]
        },
        "oldModels": {
            "@name": {
                "EN":       "Old brawler models",
                "RU":       "Старые модели бойцов"
            },
            "@description": {
                "EN":       "Replace new models with old models (TODO:convert all scw models to glb)",
                "RU":       "Заменяет новые модели старыми (TODO: конвертировать все SCW-модели в GLB)"
            },
            "@enabled": false,
            "@priority": 1,
            "@patches": [
                            "skins/hero/shelly/shellyBaseRemix.json",
                            "skins/hero/shelly/shellyPreRegRemix.json",
                            "skins/hero/shelly/shellyBanditRemix.json",
                            "skins/hero/shelly/trueMatShellyRemix.json",
                            "skins/hero/shelly/shellyFBRemix.json",
                            "skins/hero/shelly/shellyFaceFix.json",
                            "skins/hero/penny/roboPennyFix.json",
                            "skins/hero/penny/pennyBaseRemix.json",
                            "skins/hero/penny/pennyElfRemix.json",
                            "skins/hero/surge/surgeBaseRemix.json",
                            "skins/hero/bull/bullBaseRemix.json",
                            "skins/hero/jessie/jessieBaseRemix.json",
                            "skins/hero/misc/trainingBotRemix.json"
            ],

            "@root":        "skins/sc3dRoot/"

        },
        "classicRanks": {
            "@name": {
                "EN":       "Rank 1-35 rank system",
                "RU":       "Система рангов 1–35"
            },
            "@enabled": true,
            "@priority": 1,
            "@patches":     [
                            "logic/rankSystem/milestones.json",
                            "locale/ranks.json"
                            ]
        },
        "jujuRanks": {
            "@name": {
                "EN":       "Rank 1-50 rank system",
                "RU":       "Система рангов 1–50"
            },
            "@enabled": false,
            "@priority": 1,
            "@patches":     "logic/rankSystem/milestonesRMax.json"
        },

         "socialsUpdProfile": {
            "@name": {
                "EN":       "v56 profile UI",
                "RU":       "Интерфейс профиля v56"
            },
            "@description": {
                "EN":       "(battle card under brawler)",
                "RU":       "(карточка боя под бойцом)"
            },
            "@enabled": true,
            "@priority": 1,
            "@root":        "swfPatch/profile/socialsUpd"
        },
    
        "revampProfile": {
            "@name": {
                "EN":       "Pre-v56 profile UI",
                "RU":       "Интерфейс профиля до v56"
            },
            "@description": {
                "EN":       "(battle card under stats)",
                "RU":       "(карточка боя под статистикой)"
            },
            "@enabled": false,
            "@priority": 1,
            "@root":        "swfPatch/profile/revampedProfile"
        },
        "oldenProfile": {
            "@name": {
                "EN":       "Pre-v48 profile UI",
                "RU":       "Интерфейс профиля до v48"
            },
            "@description": {
                "EN":       "(no battle cards)",
                "RU":       "(без карточек боя)"
            },
            "@enabled": false,
            "@priority": 1,
            "@root":        "swfPatch/profile/ancientProfile"
        },

        "classicBrawlerSort": {
            "@name": {
                "EN":       "Old Brawler sort button behaviour",
                "RU":       "Старое поведение кнопки сортировки бойцов"
            },
            "@description": {
                "EN":       "Instead of a menu, scroll through all sorting options",
                "RU":       "Вместо меню прокручивать все варианты сортировки"
            },
            "@enabled": true,
            "@priority": 1,
            "@patches":     "client/brawlerSelector.json"
        },
        
         "gatchaPatch": {
            "@name": {
                "EN":       "Replace Starr Drops and Chaos Drops with Brawl Boxes",
                "RU":       "Заменить Старр Дропы и Дропы Хаоса на ящики Brawl"
            },
            "@description": {
                "EN":       "(Does not include box assets in daily wins, or Brawl Pass",
                "RU":       "(Не включает ресурсы ящиков в ежедневных победах или Brawl Pass"
            },
            "@enabled": true,
            "@priority": 1,
            "@patches": [
                            "logic/randomReward.json",
                            "shop/shopItems.json"
                        ]
        },
        "noSkinRarity": {
            "@name": {
                "EN":        "Remove skin rarities",
                "RU":        "Убрать редкость скинов"
            },
            "@enabled": false,
            "@priority": 1,
            "@patches":     "logic/noSkinRarity.json"
        }
        
    },
    "@patches": [
                            "locale/btcCustomStrings.json",
                            "locale/chromaPatch.json",
                            "locale/starPoints.json",
                            "locale/tokens.json",
                            "locale/oldHeroDesc.json",
                            "client/effects.json",
                            "client/sounds.json",
                            "logic/earlyAccess.json",
                            "logic/playerCards.json",
                            "logic/resources.json",
                            "logic/skinBackgroundPatch.json",
                            "logic/noPets.json",
                            "logic/skinShopNameFix.json",
                            "logic/rarities.json",
                            "swfPatch/emojiPatches/oldPins.json",
                            "logic/battleIntroHeroOffsets.json",
                            "logic/noUnlockVO.json",
                            "effects/troopDieSplatter.json",
                            "logic/gameModes.json"
    ]
}
