{
"$schema": "https://ext.nulls.gg/mods/schema/schema.json",
    "@title": { 
        "EN": "Back To Classics Playtest",
        "RU": "Тестовая версия Back To Classics"
        },
    "@description": {
     	"EN": "<nt:nolib>This mod works best on 16:9 or wider aspect ratios!\n</nt:nolib>Back To Classics is a remix on the classic feeling of Brawl Stars, with many features reimplemented from old versions of the game",
    	"RU": "<nt:nolib>Этот мод лучше всего работает при соотношении сторон 16:9 или шире!</nt:nolib>Back To Classics — это масштабное переосмысление классической атмосферы Brawl Stars, возвращающее множество элементов из старых версий игры."
    },
    "@author": "<a href=\"https://t.me/backtoclassics\">@BackToClassics</a>",
    "@version": "2.1.87",
    "@ilib": true,
    "@categories": [
        "gui",
        "sfx",
		"texts",
		"skins",
		"music",
		"environment"
    ],
    "@gv": 68,

		"@feature_groups": {
			"pins": {
			"@name": 		"Pin settings",
			"@description": "Changes behaviour of pins.\nSelect none for default behaviour.",
			"@type": 		"RADIO_GROUP",
			"@features": 	["staticEmoji", "coolerEmoji"]
					},

			"swfPatch": {
			"@name": 		"SupercellSWF Patches",
			"@description": "Enable/Disable certain aspects of the mod",
			"@type": 		"DEFAULT",
			"@features": [	"uiPatch", 
							"brawlPassPatch", 
							"buddyPatch", 
							"themePatch", 
							"eventsPatch", 
							"profilePatch", 
							"twCommonPatch", 
							"shopPatch"		]
				},

			"misc": {
			"@name": 		"Misc. settings",
			"@type": 		"DEFAULT",
			"@features": 	["noSpecialEvents"]
					},

			"dailyWins": {
			"@name": 		"Daily Wins",
			"@description": "Select none to use default version of Daily Wins.\n(Daily Wins are disabled in Null's Brawl)",
			"@type": 		"RADIO_GROUP",
			"@features": 	["dailyWinsClassic", "dailyWinsTokenBar"]
					},
	
			"ziggyStars": {
			"@name": 		"??????",
			"@description": "¿¿¿¿¿¿",
			"@type": 		"DEFAULT",
			"@features": 	["nothingOutOfTheOrdinary"]
					}
			},

		"@features": {
			"oldshop": {
				"@name":        {"EN": "Old shop",             "RU": "Старый магазин"},
				"@description": {"EN": "Enables the old shop (broken offers)", "RU": "Включает старую версию магазина"},
				"@enabled": false,
				"@priority": 1,
				"@patches": "shop/oldshop.json"	},
		
			"staticEmoji": {
				"@name":        "Static Pins",           
				"@description": "Removes all animation from pins",    
				"@enabled": true,              
				"@priority": 0,             
				"@root": 		"swfPatch/emojiPatches/staticEmoji",
				"@patches": 	"swfPatch/emojiPatches/staticEmoji/emojiPatchStatic.json"
			},
			"coolerEmoji": {
				"@name":        "Pop-in Pins",           
				"@description": "Adds a small scale-in animation to pins (will break pins in shop and brawl pass)",    
				"@enabled": false,              
				"@priority": 0,             
				"@root": 		"swfPatch/emojiPatches/coolerEmoji",
				"@patches": 	"swfPatch/emojiPatches/coolerEmoji/emojiPatchCooler.json" 
				},

			"mutePins": {
				"@name":        {"EN": "Disable pin sounds"},
				"@description": {"EN": "Removes all sounds played by pins"},
				"@enabled": true,
				"@priority": 1,
				"@patches": 			"swfPatch/emojiPatches/mutePins.json" 
				},

			"oldPortraits": {
				"@name":        {"EN": "Old brawler portraits"},
				"@description": {"EN": "Use old brawler portraits"},
				"@enabled": true,
				"@priority": 1,
				"@root":			   "skins/oldPortraits"
				},
				
			"uiPatch": {
				"@name":        {"EN": "Enable UI Patches"},
				"@description": {"EN": "Things like homescreen, battle end screen, combat hud, etc."},
				"@enabled": true,
				"@priority": 1,
				"@patches": 		   "swfPatch/ui/rankupVO.json",
				"@root": 			   "swfPatch/ui"
				},

			"brawlPassPatch": {
				"@name":        {"EN": "Enable Brawl Pass Patch"},
				"@description": {"EN": "Enable or disable old Brawl Pass"},
				"@enabled": true,
				"@priority": 1,
				"@root": 		       "swfPatch/brawlPass"
				},

			"buddyPatch": {
				"@name":        {"EN": "Enable Buddy Patches"},
				"@enabled": true,
				"@priority": 1,
				"@root": 			   "swfPatch/buddy"
				},

			"themePatch": {
				"@name":        {"EN": "Enable classic theme"},
				"@description": {"EN": "Enable or disable the custom loading screen and lobby background"},
				"@enabled": true,
				"@priority": 1,
				"@root": 			   "swfPatch/classicTheme",
				"@patches": 		   "swfPatch/classicTheme/btcTheme.json" 
				},
			"eventsPatch": {
				"@name":        {"EN": "Enable static event banners"},
				"@enabled": true,
				"@priority": 1,
				"@patches": 			   "logic/eventBanners.json"
				},

			"profilePatch": {
				"@name":        {"EN": "Enable old profile"},
				"@enabled": true,
				"@priority": 1,
				"@root": 			   "swfPatch/profile"
				},

			"twCommonPatch": {
				"@name":        {"EN": "twCommon patch"},
				"@enabled": true,
				"@priority": 1,
				"@root": 			   "swfPatch/twCommon"
				},

			"shopPatch": {
				"@name":        {"EN": "Enable New Shop Patches"},
				"@description": {"EN": "Enable patches for the new version of shop (like removing tabs)"},
				"@enabled": true,
				"@priority": 1,
				"@patches": 		   "swfPatch/shop/shopTabs.json",
				"@root": 			   "swfPatch/shop"
				},

			"noSpecialEvents": {
				"@name":        {"EN": "Remove ongoing special event"},
				"@description": {"EN": "Remove event button from mainscreen and effects"},		
				"@enabled":	 true,
				"@priority": 1,
				"@patches": 		   "logic/disableSpecialEvents.json"
				},
			"nothingOutOfTheOrdinary": {
				"@name":        {"EN": "??????"},
				"@description": {"EN": "¿¿¿¿¿¿"},
				"@enabled":	 false,
				"@priority": 999,
				"@root": 			   "swfPatch/superSecretSettings/doNotEnter/seriouslyDont/nothingHere/",
				"@patches": 		   "swfPatch/superSecretSettings/doNotEnter/seriouslyDont/nothingHere/fuckTheGameUp.json"
				},
				
			"dailyWinsClassic": {
				"@name":        {"EN": "Classic Daily Wins bar"},
				"@description": {"EN": "Use the classic black Daily Wins bar"},
				"@enabled": true,
				"@priority": 1,
				"@root": 			   "swfPatch/dailyWins"
				},

			"dailyWinsTokenBar": {
				"@name":        {"EN": "Token counter"},
				"@description": {"EN": "Replace daily wins with the classic token counter"},
				"@enabled": false,
				"@priority": 1,
				"@patches": 		   "swfPatch/dailyWins/tokenBar.json",
				"@root": 			   "swfPatch/dailyWins"
				},

			"oldEnvs": {
				"@name":        {"EN": "Old environments"},
				"@description": {"EN": "Replace all environments with old ones"},
				"@enabled": true,
				"@priority": 1,
				"@patches":	 [ 
										"envs/config/retropolis.json",
										"envs/locations/retropolis.json",
										"envs/config/darrylsShip.json",
										"envs/locations/darrylsShip.json",
										"envs/config/taraBazaar.json",
										"envs/locations/taraBazaar.json",
										"envs/locations/oldTraining.json",
										"envs/config/oldTraining.json"

				     ]
				},

			"oldModels": {
				"@name":        {"EN": "Old brawler models"},
				"@description": {"EN": "Replace new models with old models"},
				"@enabled": false,
				"@priority": 1,
				"@root": 			   "skins/models/",
				"@patches":	 [ 
										"skins/shellyBaseRemix.json"

						]

				}
			},
			
		"@patches": [ 
			"locale/btcCustomStrings.json",
			"locale/chromaPatch.json",
			"locale/starPoints.json",
			"locale/tokens.json",
			"locale/ranks.json",
			"client/effects.json",
			"client/sounds.json",
			"logic/earlyAccess.json",
			"logic/milestones.json",
			"logic/playerCards.json",
			"logic/randomReward.json",
			"logic/resources.json",
			"logic/skinBackgroundPatch.json",
			"logic/rarities.json",
			"logic/noPets.json",
			"logic/skinShopNameFix.json",
			"swfPatch/emojiPatches/oldPins.json",
			"shop/shopItems.json",
			"logic/battleIntroHeroOffsets.json"
		]
}