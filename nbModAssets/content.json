{
"$schema": "https://ext.nulls.gg/mods/schema/schema.json",
    "@title": { 
        "EN": "Back To Classics Playtest",
        "RU": "Back To Classics Playtest"
        },
    "@description": {
     "EN": "Back To Classics is a comprehensive mod that remixes many features from old versions of the game",
     "RU": "Back To Classics is a comprehensive mod that remixes many features from old versions of the game"
    },
    "@author": "graphiks, milkmid, thangcamxeng, Daniil SV",
    "@version": "2.1.87",
    "@ilib": true,
    "@categories": [
        "gui",
        "sfx"
    ],
    "@gv": 68,

	"@features": {
		"oldshop": {
			"@name": {"EN": "Old shop", "RU": "Старый магазин"},
			"@description": {"EN": "Enables the old shop", "RU": "Включает старую версию магазина"},
			"@enabled": false,
			"@priority": 1,
			"@patches": "shop/oldshop.json"
					}
				},
				
	"@patches": [
		"locale/btcCustomStrings.json",
		"locale/chromaPatch.json",
		"locale/starPoints.json",
		"locale/tokens.json",
		"client/effects.json",
		"client/shopItems.json",
		"client/sounds.json",
		"logic/btcTheme.json",
		"logic/earlyAccess.json",
		"logic/milestones.json",
		"logic/playerCards.json",
		"logic/randomReward.json",
		"logic/resources.json",
		"logic/shopTabs.json",
		"logic/skinBackgroundPatch.json",
		"logic/rarities.json"
				]
}